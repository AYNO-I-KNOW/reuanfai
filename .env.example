# apps/api
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# migrations only (psql -f), Session pooler string — Direct connection is IPv6-only
SUPABASE_DB_URL=
LINE_CHANNEL_ID=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
SESSION_JWT_SECRET=
CRON_SECRET=
# KB chat + embeddings (OpenAI-compatible, ADR-0017/0020) — AI_API_KEY/AI_BASE_URL are also needed by ingest/eval; AI_MODEL only for POST /kb/ask
# OpenAI-compatible chat endpoint (Gemini: https://generativelanguage.googleapis.com/v1beta/openai)
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
# optional fallback (ADR-0021): takes the remaining calls after a transient failure of AI_MODEL (5xx/429/timeout/invalid JSON)
# unset BASE_URL/API_KEY/REASONING_EFFORT reuse the primary's; e.g. TokenMe https://api.tokenme.limited/api/v1 + deepseek-ai/deepseek-v4-flash-0731 + none
AI_FALLBACK_MODEL=
AI_FALLBACK_BASE_URL=
AI_FALLBACK_API_KEY=
AI_FALLBACK_REASONING_EFFORT=
# leave empty for gemini-3.5-flash-lite (rejects 'none'); set 'none' for gemini 3.6/3.8 (thinking burns maxOutputTokens otherwise)
AI_REASONING_EFFORT=
# embeddings via the same AI_BASE_URL/AI_API_KEY, vector(768); default gemini-embedding-2 (changing it = re-embed everything)
AI_EMBEDDING_MODEL=
# prototype only, off until requireRole exists (set to true to mount POST /kb/ask)
KB_ASK_ENABLED=

# apps/web
# server-only: target of the /api/* rewrite (+ direct calls from server components)
API_ORIGIN=http://localhost:8787
NEXT_PUBLIC_LIFF_ID=

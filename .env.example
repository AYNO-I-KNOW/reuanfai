# apps/api
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# migrations only (psql -f), Session pooler string — Direct connection is IPv6-only
SUPABASE_DB_URL=
LINE_CHANNEL_ID=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
SESSION_JWT_SECRET=
CRON_SECRET=
# KB chat (OpenAI-compatible, ADR-0017) — only needed for POST /kb/ask
# OpenAI-compatible chat endpoint (Gemini: https://generativelanguage.googleapis.com/v1beta/openai)
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
# optional: retried once with this model (same base URL/key) when AI_MODEL answers HTTP 429, e.g. gemini-3.1-flash-lite
AI_FALLBACK_MODEL=
# leave empty for gemini-3.5-flash-lite (rejects 'none'); set 'none' for gemini 3.6/3.8 (thinking burns maxOutputTokens otherwise)
AI_REASONING_EFFORT=
# local embeddings, vector(768); default Xenova/multilingual-e5-base
AI_EMBEDDING_MODEL=
# prototype only, off until requireRole exists (set to true to mount POST /kb/ask)
KB_ASK_ENABLED=

# apps/web
# server-only: target of the /api/* rewrite (+ direct calls from server components)
API_ORIGIN=http://localhost:8787
NEXT_PUBLIC_LIFF_ID=

{
  "name": "@reuanfai/api",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/dev.ts",
    "ingest": "tsx --env-file=../../.env scripts/ingest.ts",
    "embed-suggestions": "tsx --env-file=../../.env scripts/embed-suggestions.ts",
    "eval": "tsx --env-file=../../.env scripts/eval.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.80",
    "@hono/node-server": "^2.1.1",
    "@supabase/supabase-js": "^2.118.0",
    "ai": "^7.0.154",
    "hono": "^4.13.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
